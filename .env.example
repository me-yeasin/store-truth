# Store Truth assistant (server-side only — never expose these to the browser)
# Copy to .env.local and fill in your free OpenAI-compatible provider values.

# Base URL of the chat completions API, e.g. https://api.provider.com/v1
LLM_BASE_URL=
# Model name, e.g. provider/model-id
LLM_MODEL=
# Secret API key — stays on the server, proxied via /api/assistant
LLM_API_KEY=
